# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Remote Viewer Configuration
REMOTE_VIEWER_PORT=8080
REMOTE_VIEWER_HTTPS_PORT=8443
ENABLE_HTTPS=false

# Database
DB_TYPE=sqlite
DB_PATH=./data/squirrel-nvr.db
# For PostgreSQL (optional)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=nvr_user
# DB_PASSWORD=your_password
# DB_NAME=squirrel_nvr

# Storage
STORAGE_PATH=./recordings
MAX_STORAGE_GB=500
RETENTION_DAYS=30

# RTSP/RTMP Server
RTMP_PORT=1935
RTSP_PORT=8554
HTTP_STREAM_PORT=8000

# AI Services
CODEPROJECT_AI_URL=http://localhost:32168
FRIGATE_URL=http://localhost:5000
FRIGATE_MQTT_HOST=localhost
FRIGATE_MQTT_PORT=1883

# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=SquirrelNVR <your-email@gmail.com>

# Push Notifications (Web Push / VAPID)
# Leave blank to auto-generate and persist keys under data/.vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@squirrelnvr.local

# FFmpeg (optional explicit paths; otherwise resolved from PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Security
# Leave blank to auto-generate and persist strong secrets under data/.
JWT_SECRET=change-this-to-a-random-secret-key
SESSION_SECRET=change-this-to-another-random-secret

# GPU Acceleration
# Options: nvidia, intel, amd, none
GPU_TYPE=nvidia
# For NVIDIA: cuda, for Intel: qsv, for AMD: amf
HARDWARE_ACCEL=cuda

# Features
ENABLE_MOTION_DETECTION=true
ENABLE_AI_DETECTION=true
ENABLE_LPR=true
ENABLE_AUDIO=true

# Performance
MAX_CONCURRENT_STREAMS=32
MOTION_DETECTION_FPS=5
AI_DETECTION_FPS=2
RECORDING_QUALITY=high
